{
  "name": "proximo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "lint": "biome check .",
    "format": "biome check --write .",
    "keygen": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64'))\"",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "db:generate": "pnpm --filter @proximo/db generate",
    "db:migrate": "pnpm --filter @proximo/db migrate:dev",
    "db:deploy": "pnpm --filter @proximo/db migrate:deploy",
    "db:seed": "pnpm --filter @proximo/db seed",
    "db:studio": "pnpm --filter @proximo/db studio"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
