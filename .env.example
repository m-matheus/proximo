# Copie para .env e preencha. Nunca faça commit do .env.

# ---------------------------------------------------------------------------
# Geral
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Chave de 32 bytes em base64 que cifra tokens e credenciais no banco.
# Gere com: pnpm keygen
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Banco e fila (valores do docker-compose)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://proximo:proximo@localhost:5432/proximo
DATABASE_URL_TEST=postgresql://proximo:proximo@localhost:5432/proximo_test
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=3001
# Liga as rotas do simulador de conversa. Deixe false em produção.
SIMULATOR_ENABLED=true

# ---------------------------------------------------------------------------
# Claude (Anthropic)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Modelo do agente. Alternativa mais barata para avaliar: claude-haiku-4-5
ANTHROPIC_MODEL=claude-sonnet-5-5
# Esforço de raciocínio: low | medium | high. Ignorado em modelos sem suporte.
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_TOKENS=8000
# default liga o fallback do servidor em recusas de segurança. off desliga.
ANTHROPIC_FALLBACKS=default
# O que fazer se o histórico reenviado não bater com o original: drop_block | error
ANTHROPIC_PREFIX_MISMATCH=drop_block

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (Meta)
# ---------------------------------------------------------------------------
WHATSAPP_GRAPH_API_VERSION=v26.0
# App secret do app da Meta. Valida a assinatura dos webhooks.
WHATSAPP_APP_SECRET=
# Token que você escolhe e cadastra no painel da Meta ao configurar o webhook.
WHATSAPP_VERIFY_TOKEN=
# Opcional: número de teste da Meta. Com estes dados, o seed cria o canal da barbearia de exemplo.
WHATSAPP_TEST_PHONE_NUMBER_ID=
WHATSAPP_TEST_ACCESS_TOKEN=
WHATSAPP_TEST_WABA_ID=

# ---------------------------------------------------------------------------
# Agente
# ---------------------------------------------------------------------------
# Espera por mais mensagens do cliente antes de responder, em milissegundos.
AGENT_DEBOUNCE_MS=2500
# Horas sem conversa até o agente abrir uma sessão nova com resumo.
AGENT_SESSION_IDLE_HOURS=6
# Horas que a conversa fica com a equipe depois de um handoff ou de uma resposta pelo celular.
AGENT_HUMAN_MODE_HOURS=12
# Limite de execuções do agente por cliente por dia, contra abuso e custo.
AGENT_MAX_RUNS_PER_CUSTOMER_PER_DAY=40

# ---------------------------------------------------------------------------
# Painel web
# ---------------------------------------------------------------------------
# Endereço da API usado pelo painel.
API_URL=http://localhost:3001
